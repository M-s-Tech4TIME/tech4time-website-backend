# Tech4TIME — admin.tech4time.bd
#
# HEADERS ONLY. Nothing here is what keeps anything secret.
#
# The document root is public/, so lib/, sections/ and content/ are not blocked
# by a rule — they are outside the tree a URL can reach. Delete this file and
# the admin becomes indexable and unhardened; it does not become readable.
# That is deliberate, and it is the reason the backend has this shape at all:
# a rule is a policy the server chooses to apply, and this is a new host whose
# .htaccess has never been tested. See docs/90-decisions/0018-….md.
#
# It is also why there is no RewriteRule ^lib/ here. Adding one would suggest
# that something depends on it.

# --------------------------------------------------------------------------
# 1. Security headers
#
# The CSP is the same one the public site runs, and for the same reason: no
# CDN, no external origin, no inline style or script. The editor's rich text is
# sanitised by lib/html.php before it is stored and again by the frontend on
# receipt; this is the layer that means a mistake in either cannot execute.
#
# ONE DELIBERATE WIDENING: img-src also names the public site.
#
# The company profile editor shows each row's artwork, and most of that artwork
# ships with the site rather than having been uploaded — it exists only on
# tech4time.bd, so under a bare 'self' every one of those rows would draw a
# broken image. The alternatives were worse: copying the frontend's assets here
# duplicates them, and dropping the previews makes reordering fifty logos a
# guessing game.
#
# It is exactly one origin, and only for images. No script, no style, no frame
# and no connect — none of which this widening touches. The origin is the site
# this admin exists to edit, and if it were serving something hostile the
# public site would already be serving it to everybody.
# --------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https://tech4time.bd; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"

    # ----------------------------------------------------------------------
    # A BLANKET RULE, NOT A PATH MATCH.
    #
    # The public site marks the editor noindex with
    #   expr=%{REQUEST_URI} =~ m#^/admin(/|$)#
    # and on this host the URI is "/" — so that rule matches nothing here and
    # would fail silently, with the editor quietly indexable. ADR 0011
    # catalogued this before the move; this is the fix.
    #
    # `always` is the operative word: without it the header is attached only to
    # 2xx responses, and the login page answers a crawler with 200 while every
    # other URL here answers with a redirect.
    # ----------------------------------------------------------------------
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
    Header always set Cache-Control "no-store, max-age=0"

    # Assets are the exception: they carry no session and are fetched on every
    # page of the editor.
    #
    # A YEAR AND `immutable` ARE ONLY SAFE BECAUSE THE URLS CARRY A VERSION.
    # There is no build step here, so the filenames never change; admin_asset()
    # in lib/admin.php puts the file's own modification time on the end of every
    # href and src the shell writes, and that is what a browser keys its cache
    # on. Take that away and this line becomes a promise the deploy cannot keep.
    #
    # It has already been broken once, exactly that way. A deploy shipped a new
    # shell and the browsers kept the old stylesheet: `immutable` tells the
    # browser not to revalidate on an ORDINARY reload, so pressing F5 -- the one
    # thing a person tries -- changed nothing. What they saw was an admin with
    # unstyled controls and a page that looked, correctly, broken. Only a forced
    # reload would have cleared it, and nobody knows to reach for that.
    <FilesMatch "\.(css|js|woff2|png|webp|svg|ico)$">
        Header always set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # HSTS. includeSubDomains is deliberately absent, here and on the public
    # site: this IS the subdomain, and asserting it from either side before
    # AutoSSL has issued for every name would make an unissued one unreachable.
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# --------------------------------------------------------------------------
# 2. https, the front door, and no directory listings
# --------------------------------------------------------------------------

# EVERY SCREEN IS index.php WITH A DIFFERENT ?s=, so this is the whole of the
# routing. Declared rather than left to the host's default, which is the same
# thing the public site's .htaccess does and for the same reason: what a server
# picks for "/" when nobody says is its own business, it differs between Apache
# and LiteSpeed and between cPanel builds, and the admin posts every form back
# to "/" with a query string. A default that resolves a GET and not a POST
# turns every button in the editor into a 404 that no code here can produce --
# nothing in this repository ever answers 404, so an unexplained one is the
# server routing, and this is the line that stops it depending on luck.
DirectoryIndex index.php

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

    # Any path segment beginning with a dot — .git/, .env, .svn/ — whatever
    # ends up here. .well-known stays reachable or AutoSSL cannot renew, and a
    # certificate that silently stops renewing is discovered months later.
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule "(^|/)\." - [F,L]

    # uploads/ is the only directory on this host holding files that arrived
    # from somebody's computer, and it must be SERVED — the editor draws each
    # row's picture from it. So it gets an allow-list rather than a block:
    # sixteen hex characters, a dot, and one of three raster extensions, which
    # is exactly the shape lib/upload.php computes from the re-encoded bytes.
    # Anything else under uploads/ is refused before a handler sees it, so a
    # .php there could not run even if one existed.
    #
    # Identical to the rule on the public site, and for the same reason: this
    # is the third of ADR 0019's three layers, and the only one that still
    # holds if the other two are wrong.
    RewriteCond %{REQUEST_URI} !^/uploads/[0-9a-f]{16}\.(webp|jpe?g|png|svg)$
    RewriteRule ^uploads/. - [F,L]

    # THE FIFTH LAYER, AND THE ONE THAT MAKES A VECTOR FILE SAFE TO SERVE AT
    # ALL. Sanitising an SVG leaves a document, and a document in this origin
    # is a document that could act in it. So an .svg under uploads/ is never
    # served as one: Content-Disposition makes a browser save it rather than
    # render it, and the CSP is a second answer in case something navigates to
    # it anyway — no scripts, no fetches, no same-origin anything.
    #
    # Nothing on this site draws these files. The branding page LINKS to them;
    # its previews are raster. The download="" attribute names the file for the
    # visitor; this is what makes the address itself harmless.
    #
    # expr= rather than <FilesMatch> so the PATH is matched and not just the
    # name — the rule must apply under uploads/ and nowhere else. Same form as
    # the /admin and /api rules further down.
    <IfModule mod_headers.c>
        Header always set Content-Disposition "attachment" "expr=%{REQUEST_URI} =~ m#^/uploads/[0-9a-f]{16}\.svg$#"
        Header always set Content-Security-Policy "default-src 'none'; sandbox" "expr=%{REQUEST_URI} =~ m#^/uploads/[0-9a-f]{16}\.svg$#"
    </IfModule>

</IfModule>

# --------------------------------------------------------------------------
# 3. Extensions that are never part of a website
#
# Belt and braces. Nothing matching these is deployed into public/ — the upload
# set is an allow list — but an archive or a note left here by hand would
# otherwise be downloadable in full, which is exactly how a repository zip once
# ended up readable on the public site.
# --------------------------------------------------------------------------
<FilesMatch "\.(md|py|sh|json|lock|yml|yaml|zip|tar|gz|tgz|bz2|rar|7z|sql|bak|log|env|ini)$">
    Require all denied
</FilesMatch>

<Files "error_log">
    Require all denied
</Files>

# --------------------------------------------------------------------------
# 4. DIRECTORY PRIVACY MUST NOT BE LEFT ON THIS DIRECTORY
#
# cPanel's Directory Privacy writes its OWN .htaccess into whatever directory
# it protects — which would be this file. Every deploy ships this one, so a
# deploy would overwrite cPanel's and silently remove the password.
#
# That is not a conflict to be solved by protecting the file. The application's
# own sign-in is the lock (ADR 0005: argon2id, a second factor, a lockout and
# an audit log), and Directory Privacy is only useful here for the few minutes
# between the first deploy and the first account existing. Switch it on before
# that window, and switch it OFF before the next deploy.
#
# The frontend is the opposite case, and it is worth knowing why they differ:
# there, cPanel owned admin/.htaccess and the repository never shipped one, so
# the deploy protects it. Here the repository owns the file. See
# docs/90-decisions/0016-a-deploy-protects-what-the-panel-owns.md.
# --------------------------------------------------------------------------
